---
import GameLayout from "../layouts/GameLayout.astro";
import Lander from "@/Lander.svelte";
---

<GameLayout title="Suburble - The Daily Melbourne Suburb Guessing Game">
    <Lander client:load>
        <a
            href="/game"
            class="block group cursor-pointer bg-gray border rounded-xl w-[230px] lg:w-[400px]"
        >
            <h1 class="text-center underline text-3xl">
                <span class="font-bold"> Play </span>
                <span> Daily </span>
            </h1>
            <div
                class="aspect-square overflow-clip bg-white border m-2 rounded"
            >
                <img
                    class="group-hover:scale-105 transition-transform"
                    alt=""
                    src="/assets/map.svg"
                />
            </div>
        </a>
    </Lander>
</GameLayout>
