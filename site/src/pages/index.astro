---
import GameLayout from "../layouts/GameLayout.astro";
import Lander from "@/Lander.svelte";
import { dates } from "@j/dates.json";

const parts = new Intl.DateTimeFormat("en-AU", {
    timeZone: "Australia/Melbourne",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
}).formatToParts();

const { year, month, day } = Object.fromEntries(
    parts.map((p) => [p.type, p.value]),
);
const dateKey = `${year}-${month}-${day}` as keyof typeof dates;
---

<GameLayout title="Suburble - The Daily Melbourne Suburb Guessing Game">
    <Lander dateKey={dateKey} client:load />
</GameLayout>
